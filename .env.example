# =========================================================
# Plantilla del .env del backend. Guia completa con valores para
# local y produccion: docs/configuracion-entornos.md
# =========================================================

# --- Aplicacion -------------------------------------------
# local | staging | production (otro valor impide arrancar). Con "production"
# Alembic y los scripts piden confirmacion. Si DATABASE_URL apunta a produccion,
# usa "production" aunque estes en tu computador.
APP_ENV=local
# 1 solo en local (recarga y depurador). Produccion: SIEMPRE 0.
FLASK_DEBUG=1
# DEBUG | INFO | WARNING | ERROR. Local: INFO (DEBUG al depurar). Produccion: INFO.
LOG_LEVEL=INFO
# Origenes del frontend separados por comas, sin "/" final y nunca "*".
# Local: http://localhost:5173 · Produccion: https://<dominio-del-frontend>
CORS_ORIGINS=http://localhost:5173

# --- Supabase (publico) -----------------------------------
# Project Settings > Data API > Project URL. Valida los tokens de inicio de sesion.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Project Settings > API Keys > "anon public" (o la "publishable key", sb_publishable_...).
# Con ella el backend registra, inicia, renueva y cierra sesiones en Supabase Auth
# (HU-B-322): el frontend ya no habla con Supabase. Es publica (no ignora RLS), pero
# solo vive aqui. NUNCA pongas la service_role / secret key. Sin ella, /auth/* responde 503.
SUPABASE_ANON_KEY=TU-ANON-KEY

# --- Cookie de sesion (HU-B-322) ----------------------------
# El refresh token viaja en la cookie httpOnly "sipe_refresh".
# Secure (solo HTTPS): vacio = automatico (0 en local, 1 en staging/production).
# Fuera de local no se permite 0.
AUTH_COOKIE_SECURE=
# Lax si frontend y API comparten sitio (localhost:5173 y localhost:5000, o
# app.sipesound.co y api.sipesound.co). None solo si estan en dominios distintos
# (p. ej. *.vercel.app y *.onrender.com); exige AUTH_COOKIE_SECURE=1.
AUTH_COOKIE_SAMESITE=Lax

# --- Codigos de verificacion (HU-B-402) --------------------
# SECRETA, obligatoria (sin ella la app, Alembic y los scripts no arrancan). Clave del HMAC con
# que se guardan los codigos: en la base solo queda el hash. 32+ caracteres aleatorios:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Cambiarla invalida los codigos pendientes (las personas piden uno nuevo).
CODIGOS_SECRETO=

# --- Correo saliente (HU-B-401) ----------------------------
# El backend envia sus propios correos: codigo de verificacion al registrarse, enlace para
# restablecer la contrasena y avisos de seguridad. Salen por el SMTP de Gmail.
#
# CORREO_MODO decide QUE HACE el backend con cada correo:
#   smtp    -> lo ENVIA de verdad por Gmail al buzon de la persona. Es lo que se usa en
#              produccion. Exige SMTP_USUARIO y SMTP_CLAVE_APLICACION (abajo).
#   archivo -> NO lo envia: lo guarda como un archivo .eml en tmp/correos/ dentro del backend.
#              Abrelo con cualquier cliente de correo (o el Bloc de notas) y lee el codigo.
#              Sirve para desarrollar sin configurar Gmail, sin gastar el limite diario de
#              envios (~500) y sin escribirle por error a otras personas.
#              SOLO se permite con APP_ENV=local (en otro entorno la app no arranca).
#   (vacio) -> automatico: "archivo" si APP_ENV=local y "smtp" en cualquier otro entorno.
#
# Que poner:
#   Desarrollo sin Gmail ........ CORREO_MODO=archivo  (SMTP_* se pueden dejar como estan)
#   Probar el envio real ........ CORREO_MODO=smtp     y completar SMTP_USUARIO y
#                                                       SMTP_CLAVE_APLICACION
#   Staging / produccion ........ CORREO_MODO=smtp     (o vacio, es lo mismo)
# Con "smtp", si falta SMTP_USUARIO o SMTP_CLAVE_APLICACION la app no arranca y dice cual.
CORREO_MODO=

# --- Solo se usan con CORREO_MODO=smtp ---
# Servidor de Gmail: no se cambia.
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=587
# Cuenta de Gmail que envia los correos.
SMTP_USUARIO=tu-cuenta@gmail.com
# SECRETA. Contrasena de aplicacion de 16 caracteres. NO es la contrasena de la cuenta.
# Se crea en: Cuenta de Google > Seguridad > Verificacion en dos pasos (activala primero)
# > Contrasenas de aplicaciones. Se puede pegar con o sin los espacios que muestra Google.
SMTP_CLAVE_APLICACION=
# Direccion que ven los destinatarios. Vacio = SMTP_USUARIO. Si pones otra, debe ser un alias
# verificado en Gmail (Configuracion > Cuentas > Enviar como); si no, Gmail la reemplaza.
CORREO_REMITENTE=
# Nombre que ven los destinatarios junto a la direccion.
CORREO_NOMBRE_REMITENTE=SIPE-SOUND

# --- Se usa con cualquier modo ---
# Direccion del frontend, para armar los enlaces de los correos (p. ej. restablecer contrasena).
# Sin "/" final y debe estar tambien en CORS_ORIGINS. Produccion: https://<dominio-del-frontend>
URL_FRONTEND=http://localhost:5173

# --- Base de datos (SECRETA) -------------------------------
# UNICA conexion: la usan la app y Alembic.
# Supabase > Connect > Connection string > Method: "Session pooler" (puerto 5432).
# Nunca el Transaction pooler (6543).
DATABASE_URL=postgresql://postgres.TU-PROYECTO:TU-PASSWORD@aws-0-TU-REGION.pooler.supabase.com:5432/postgres

# 1 = registrar cada sentencia SQL con sus valores (solo para depurar en local).
# Produccion: SIEMPRE 0.
SQLALCHEMY_ECHO=0
