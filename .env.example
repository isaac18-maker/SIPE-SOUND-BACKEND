APP_ENV=local
FLASK_DEBUG=1
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=TU-ANON-KEY
# Verificacion del JWT (al menos una):
#  - Claves asimetricas (recomendado): URL publica del JWKS del proyecto
SUPABASE_JWKS_URL=https://TU-PROYECTO.supabase.co/auth/v1/.well-known/jwks.json
#  - Clave heredada HS256: Supabase > Project Settings > API > JWT Secret
# SUPABASE_JWT_SECRET=TU-JWT-SECRET
# Conexion DIRECTA a PostgreSQL (puerto 5432), solo para migraciones e inventario.
# Supabase > Project Settings > Database > Connection string > "Direct connection"
DATABASE_URL_MIGRATIONS=postgresql://postgres:TU-PASSWORD@db.TU-PROYECTO.supabase.co:5432/postgres
# Acceso a datos de la app: "supabase" (API REST) o "sql" (SQLAlchemy).
DATA_BACKEND=supabase
# Conexion de la app via pooler en modo transaccion (puerto 6543). Requerida si DATA_BACKEND=sql.
# Supabase > Connect > "Transaction pooler"
DATABASE_URL=postgresql://postgres.TU-PROYECTO:TU-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Registrar en el log cada sentencia SQL (solo para depurar).
SQLALCHEMY_ECHO=0
