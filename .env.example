# =========================================================
# Plantilla del .env del backend. Guia completa con valores para
# local y produccion: docs/configuracion-entornos.md
# =========================================================

# --- Aplicacion -------------------------------------------
# local | staging | production (otro valor impide arrancar). Con "production"
# Alembic y los scripts piden confirmacion. Si DATABASE_URL apunta a produccion,
# usa "production" aunque estes en tu computador.
APP_ENV=local
# 1 solo en local (recarga y depurador). Produccion: SIEMPRE 0.
FLASK_DEBUG=1
# DEBUG | INFO | WARNING | ERROR. Local: INFO (DEBUG al depurar). Produccion: INFO.
LOG_LEVEL=INFO
# Origenes del frontend separados por comas, sin "/" final y nunca "*".
# Local: http://localhost:5173 · Produccion: https://<dominio-del-frontend>
CORS_ORIGINS=http://localhost:5173

# --- Supabase (publico) -----------------------------------
# Project Settings > Data API > Project URL. Valida los tokens de inicio de sesion.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Project Settings > API Keys > "anon public" (o la "publishable key", sb_publishable_...).
# Con ella el backend registra, inicia, renueva y cierra sesiones en Supabase Auth
# (HU-B-322): el frontend ya no habla con Supabase. Es publica (no ignora RLS), pero
# solo vive aqui. NUNCA pongas la service_role / secret key. Sin ella, /auth/* responde 503.
SUPABASE_ANON_KEY=TU-ANON-KEY

# --- Cookie de sesion (HU-B-322) ----------------------------
# El refresh token viaja en la cookie httpOnly "sipe_refresh".
# Secure (solo HTTPS): vacio = automatico (0 en local, 1 en staging/production).
# Fuera de local no se permite 0.
AUTH_COOKIE_SECURE=
# Lax si frontend y API comparten sitio (localhost:5173 y localhost:5000, o
# app.sipesound.co y api.sipesound.co). None solo si estan en dominios distintos
# (p. ej. *.vercel.app y *.onrender.com); exige AUTH_COOKIE_SECURE=1.
AUTH_COOKIE_SAMESITE=Lax

# --- Base de datos (SECRETA) -------------------------------
# UNICA conexion: la usan la app y Alembic.
# Supabase > Connect > Connection string > Method: "Session pooler" (puerto 5432).
# Nunca el Transaction pooler (6543).
DATABASE_URL=postgresql://postgres.TU-PROYECTO:TU-PASSWORD@aws-0-TU-REGION.pooler.supabase.com:5432/postgres

# 1 = registrar cada sentencia SQL con sus valores (solo para depurar en local).
# Produccion: SIEMPRE 0.
SQLALCHEMY_ECHO=0
