# Aplicacion
APP_ENV=local
FLASK_DEBUG=1
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# Proyecto de Supabase (publico): emisor y claves publicas para validar los tokens
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# UNICA conexion a PostgreSQL (secreta). La usan la app y Alembic.
# Supabase > Connect > Connection string > Method: "Session pooler" (puerto 5432)
DATABASE_URL=postgresql://postgres.TU-PROYECTO:TU-PASSWORD@aws-0-TU-REGION.pooler.supabase.com:5432/postgres

# Registrar en el log cada sentencia SQL (solo para depurar)
SQLALCHEMY_ECHO=0
